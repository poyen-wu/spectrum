import React, { useEffect, useMemo, useRef, useState } from "react";
import { Box, Stack, Typography, useTheme } from "@mui/material";

const BAND_SIZE = 10;

// Colors for 5..1 points (tweak to taste)
const BAND_COLORS = {
  5: "#2e7d32", // green
  4: "#66bb6a",
  3: "#fdd835", // yellow
  2: "#fb8c00", // orange
  1: "#e53935"  // red
};

function clamp(n, a, b) {
  return Math.max(a, Math.min(b, n));
}

function scoreAt(pos, target) {
  const diff = Math.abs(pos - target);
  const band = Math.floor(diff / BAND_SIZE);
  return clamp(5 - band, 1, 5);
}

/** Builds contiguous segments across 0..100 with a color per score, based on target. */
function buildScoreSegments(target) {
  if (typeof target !== "number") return [];
  const segs = [];
  let start = 0;
  let curScore = scoreAt(0, target);

  for (let x = 1; x <= 100; x++) {
    const s = scoreAt(x, target);
    if (s !== curScore) {
      segs.push({ from: start, to: x, score: curScore });
      start = x;
      curScore = s;
    }
  }
  segs.push({ from: start, to: 101, score: curScore }); // to is exclusive-ish
  return segs;
}

/**
 * SpectrumBar (visual "card")
 *
 * Props:
 * - left, right: endpoint labels
 * - value: pointer position (0..100)
 * - onChange(newValue): called when clicking/dragging pointer
 * - disabled: disables pointer movement
 * - showTarget: show vertical target line (and optional bands)
 * - targetValue: 0..100
 * - showBands: show colored scoring bands around target
 * - pointerLabel: optional label above pointer (e.g. "Your guess")
 */
export default function SpectrumBar({
  left,
  right,
  value = 50,
  onChange,
  disabled = false,
  showTarget = false,
  targetValue,
  showBands = true,
  pointerLabel
}) {
  const theme = useTheme();
  const trackRef = useRef(null);
  const [dragging, setDragging] = useState(false);

  const safeValue = clamp(Math.round(value), 0, 100);

  const segments = useMemo(() => {
    if (!showBands || !showTarget) return [];
    return buildScoreSegments(targetValue);
  }, [showBands, showTarget, targetValue]);

  const setFromClientX = (clientX) => {
    const el = trackRef.current;
    if (!el) return;
    const rect = el.getBoundingClientRect();
    const pct = ((clientX - rect.left) / rect.width) * 100;
    const v = clamp(Math.round(pct), 0, 100);
    onChange?.(v);
  };

  const onPointerDown = (e) => {
    if (disabled || !onChange) return;
    e.preventDefault();
    setDragging(true);
    const x = e.touches?.[0]?.clientX ?? e.clientX;
    setFromClientX(x);
  };

  useEffect(() => {
    if (!dragging) return;

    const onMove = (e) => {
      const x = e.touches?.[0]?.clientX ?? e.clientX;
      setFromClientX(x);
    };
    const onUp = () => setDragging(false);

    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseup", onUp);
    window.addEventListener("touchmove", onMove, { passive: false });
    window.addEventListener("touchend", onUp);

    return () => {
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseup", onUp);
      window.removeEventListener("touchmove", onMove);
      window.removeEventListener("touchend", onUp);
    };
  }, [dragging]);

  return (
    <Stack spacing={1}>
      <Stack direction="row" justifyContent="space-between" sx={{ gap: 2 }}>
        <Typography variant="body2" sx={{ opacity: 0.9 }}>{left}</Typography>
        <Typography variant="body2" sx={{ opacity: 0.9 }}>{right}</Typography>
      </Stack>

      <Box
        ref={trackRef}
        onMouseDown={onPointerDown}
        onTouchStart={onPointerDown}
        role="application"
        aria-label="Spectrum card"
        sx={{
          position: "relative",
          height: { xs: 56, sm: 64 },
          borderRadius: 3,
          overflow: "hidden",
          cursor: disabled ? "default" : "pointer",
          userSelect: "none",
          touchAction: "none",
          border: `1px solid ${theme.palette.divider}`,
          // base background when not showing bands
          background:
            "linear-gradient(90deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.10) 50%, rgba(255,255,255,0.06) 100%)"
        }}
      >
        {/* Colored score bands (only when showing target) */}
        {segments.map((seg, idx) => (
          <Box
            key={idx}
            sx={{
              position: "absolute",
              left: `${seg.from}%`,
              width: `${seg.to - seg.from}%`,
              top: 0,
              bottom: 0,
              bgcolor: BAND_COLORS[seg.score],
              opacity: 0.55
            }}
          />
        ))}

        {/* Subtle tick marks */}
        {[0, 25, 50, 75, 100].map((t) => (
          <Box
            key={t}
            sx={{
              position: "absolute",
              left: `${t}%`,
              top: 0,
              bottom: 0,
              width: 1,
              bgcolor: "rgba(255,255,255,0.10)"
            }}
          />
        ))}

        {/* Target marker */}
        {showTarget && typeof targetValue === "number" && (
          <Box
            title="Target"
            sx={{
              position: "absolute",
              left: `${clamp(targetValue, 0, 100)}%`,
              top: 0,
              bottom: 0,
              width: 3,
              transform: "translateX(-50%)",
              bgcolor: theme.palette.secondary.main,
              boxShadow: `0 0 0 2px rgba(0,0,0,0.25)`
            }}
          />
        )}

        {/* Pointer (guess) */}
        <Box
          sx={{
            position: "absolute",
            left: `${safeValue}%`,
            top: 0,
            bottom: 0,
            transform: "translateX(-50%)",
            pointerEvents: "none"
          }}
        >
          {/* optional label */}
          {pointerLabel && (
            <Box
              sx={{
                position: "absolute",
                top: 6,
                left: "50%",
                transform: "translateX(-50%)",
                px: 1,
                py: 0.25,
                borderRadius: 1,
                bgcolor: "rgba(0,0,0,0.35)",
                border: `1px solid ${theme.palette.divider}`
              }}
            >
              <Typography variant="caption" sx={{ lineHeight: 1 }}>
                {pointerLabel}
              </Typography>
            </Box>
          )}

          {/* vertical line */}
          <Box
            sx={{
              position: "absolute",
              left: "50%",
              top: 0,
              bottom: 0,
              width: 2,
              transform: "translateX(-50%)",
              bgcolor: disabled ? "rgba(255,255,255,0.55)" : theme.palette.primary.main
            }}
          />

          {/* triangle pointer */}
          <Box
            sx={{
              position: "absolute",
              left: "50%",
              bottom: 6,
              transform: "translateX(-50%)",
              width: 0,
              height: 0,
              borderLeft: "8px solid transparent",
              borderRight: "8px solid transparent",
              borderTop: `12px solid ${
                disabled ? "rgba(255,255,255,0.70)" : theme.palette.primary.main
              }`,
              filter: "drop-shadow(0 1px 2px rgba(0,0,0,0.35))"
            }}
          />
        </Box>

        {/* Value readout (bottom center) */}
        <Box
          sx={{
            position: "absolute",
            left: "50%",
            bottom: 6,
            transform: "translateX(-50%)",
            px: 1,
            py: 0.25,
            borderRadius: 1,
            bgcolor: "rgba(0,0,0,0.35)",
            border: `1px solid ${theme.palette.divider}`
          }}
        >
          <Typography variant="caption" sx={{ lineHeight: 1 }}>
            {safeValue}
          </Typography>
        </Box>
      </Box>

      {/* Small scoring legend when bands are visible */}
      {showTarget && showBands && typeof targetValue === "number" && (
        <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", opacity: 0.9 }}>
          {[5, 4, 3, 2, 1].map((s) => (
            <Stack key={s} direction="row" spacing={0.75} alignItems="center">
              <Box sx={{ width: 12, height: 12, borderRadius: 0.75, bgcolor: BAND_COLORS[s], opacity: 0.8 }} />
              <Typography variant="caption">{s}pt</Typography>
            </Stack>
          ))}
        </Stack>
      )}
    </Stack>
  );
}
